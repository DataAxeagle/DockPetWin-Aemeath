<Window x:Class="DockCatWin.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌宠的小屋"
        Width="620"
        Height="430"
        MinWidth="420"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="#FFF6CFE2"
        FontFamily="Microsoft YaHei UI"
        Icon="Resources/App/pet-app-icon.png">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#2C2035" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7B4D70" />
        <SolidColorBrush x:Key="LineBrush" Color="#A7477C" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFF4FA" />
        <SolidColorBrush x:Key="AccentBrush" Color="#F06B9C" />

        <Style TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="#FFFFDDF0" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFFFC9E4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFF4A6CF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="2"
                CornerRadius="0"
                Padding="8"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TitleText"
                               Text="桌宠的小屋"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource InkBrush}" />
                    <TextBlock x:Name="StatusText"
                               Text="正在回家..."
                               FontSize="10"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="聊天"
                        Width="54"
                        Margin="8,0,6,0"
                        VerticalAlignment="Center"
                        Click="Chat_Click" />
                <Button Grid.Column="2"
                        Content="设置"
                        Width="54"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Click="Settings_Click" />
                <Button Grid.Column="3"
                        Content="换个动作"
                        Width="76"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Click="RefreshActivity_Click" />
                <Button Grid.Column="4"
                        Content="关门"
                        Width="54"
                        VerticalAlignment="Center"
                        Click="Close_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="2"
                CornerRadius="0"
                ClipToBounds="True"
                Background="White">
            <Grid x:Name="SceneHost">
                <Viewbox Stretch="Uniform">
                    <Canvas x:Name="SceneCanvas"
                            Width="1792"
                            Height="1024"
                            ClipToBounds="True">
                        <Image x:Name="BackgroundImage"
                               Source="Resources/Home/v3/background/empty-room.png"
                               Width="1792"
                               Height="1024"
                               Stretch="Fill"
                               Panel.ZIndex="0"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Image x:Name="BedLayer"
                               Source="Resources/Home/v3/objects/bed.png"
                               Canvas.Left="90"
                               Canvas.Top="392"
                               Width="395"
                               Height="315"
                               Stretch="Uniform"
                               Panel.ZIndex="4"
                               IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Image x:Name="StudyDeskLayer"
                               Source="Resources/Home/v3/objects/study_desk.png"
                               Canvas.Left="760"
                               Canvas.Top="250"
                               Width="390"
                               Height="315"
                               Stretch="Uniform"
                               Panel.ZIndex="4"
                               IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Image x:Name="GamingDeskLayer"
                               Source="Resources/Home/v3/objects/gaming_desk.png"
                               Canvas.Left="1240"
                               Canvas.Top="265"
                               Width="440"
                               Height="345"
                               Stretch="Uniform"
                               Panel.ZIndex="4"
                               IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Image x:Name="SofaTableLayer"
                               Source="Resources/Home/v3/objects/sofa_table.png"
                               Canvas.Left="820"
                               Canvas.Top="620"
                               Width="430"
                               Height="320"
                               Stretch="Uniform"
                               Panel.ZIndex="4"
                               IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Image x:Name="TeaTableLayer"
                               Source="Resources/Home/v3/objects/tea_table.png"
                               Canvas.Left="1305"
                               Canvas.Top="640"
                               Width="270"
                               Height="205"
                               Stretch="Uniform"
                               Panel.ZIndex="4"
                               IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Image x:Name="PetImage"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Image x:Name="ForegroundImage"
                               Width="1792"
                               Height="1024"
                               Stretch="Fill"
                               IsHitTestVisible="False"
                               Visibility="Collapsed"
                               Panel.ZIndex="14"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Border x:Name="HomeSpeechBubble"
                                Canvas.Left="760"
                                Canvas.Top="170"
                                Panel.ZIndex="18"
                                Width="420"
                                Visibility="Collapsed"
                                Background="#EFFFF4FA"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="3"
                                CornerRadius="0"
                                Padding="14">
                            <TextBlock x:Name="HomeSpeechText"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxHeight="130"
                                       FontSize="22"
                                       LineHeight="30"
                                       Foreground="{StaticResource InkBrush}" />
                        </Border>
                        <Border Canvas.Left="1290"
                                Canvas.Top="34"
                                Panel.ZIndex="20"
                                Width="455"
                                Background="#EFFFF4FA"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="3"
                                CornerRadius="0"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="最近行事历"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="16" />
                                <TextBlock x:Name="HomeLogText"
                                           Text="正在读取最近的小屋记录。"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource InkBrush}"
                                           FontSize="18"
                                           LineHeight="26"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Canvas.Left="34"
                                Canvas.Top="34"
                                Panel.ZIndex="20"
                                MaxWidth="360"
                                Background="#EFFFF4FA"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="3"
                                CornerRadius="0"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="现在她在做什么"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="16" />
                                <TextBlock x:Name="ActivityText"
                                           Text="正在挑一个舒服的位置。"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource InkBrush}"
                                           FontSize="22"
                                           LineHeight="30"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Canvas>
                </Viewbox>
            </Grid>
        </Border>
    </Grid>
</Window>
