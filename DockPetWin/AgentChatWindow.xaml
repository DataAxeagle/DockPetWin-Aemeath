<Window x:Class="DockPetWin.AgentChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="和爱弥斯聊天"
        Width="720"
        Height="560"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFF7FB"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#302A36" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7B6879" />
        <SolidColorBrush x:Key="LineBrush" Color="#F0DCE7" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#F06B9C" />

        <Style TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="#FFFFF2F8" />
            <Setter Property="BorderBrush" Value="#E8B9CF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFFFE6F2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFFFD7E9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#FFFFFFFF"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="42"
                        Height="42"
                        CornerRadius="8"
                        Background="#FFFFE8F3"
                        BorderBrush="#E8B9CF"
                        BorderThickness="1">
                    <Image x:Name="HeaderIconImage" Stretch="Uniform" Margin="5" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock x:Name="TitleText"
                               Text="和爱弥斯聊天"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" />
                    <TextBlock x:Name="StatusText"
                               Text="正在加载 Agent"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <Button x:Name="ImmersiveTabButton"
                            Content="沉浸"
                            MinWidth="68"
                            Height="34"
                            ToolTip="沉浸对话会使用小屋语境和首次重逢背景"
                            Click="ImmersiveTab_Click" />
                    <Button x:Name="DailyTabButton"
                            Content="办事"
                            MinWidth="68"
                            Height="34"
                            Margin="6,0,0,0"
                            ToolTip="工具办事会使用独立的任务上下文，并允许执行已启用的工具"
                            Click="DailyTab_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="#FFFFFBFD"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8">
            <ScrollViewer x:Name="ConversationScroll"
                          VerticalScrollBarVisibility="Auto"
                          Background="Transparent"
                          MinHeight="260">
                <StackPanel x:Name="ConversationPanel" />
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Background="White"
                    BorderBrush="#E8B9CF"
                    BorderThickness="1"
                    CornerRadius="8"
                    Height="42">
                <TextBox x:Name="InputBox"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="12,8"
                         AcceptsReturn="False"
                         TextWrapping="NoWrap"
                         VerticalContentAlignment="Center"
                         VerticalScrollBarVisibility="Disabled"
                         KeyDown="InputBox_KeyDown" />
            </Border>
            <Button Grid.Column="1"
                    Content="配置目录"
                    MinWidth="96"
                    Height="42"
                    Margin="10,0,0,0"
                    Click="OpenFolder_Click" />
            <Button Grid.Column="2"
                    Content="清除对话"
                    MinWidth="96"
                    Height="42"
                    Margin="8,0,0,0"
                    ToolTip="清空当前上下文并归档旧对话入口；本地历史仍会保留"
                    Click="ClearConversation_Click" />
            <Button x:Name="SendButton"
                    Grid.Column="3"
                    Content="发送"
                    MinWidth="82"
                    Height="42"
                    Margin="8,0,0,0"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButton}"
                    Click="Send_Click" />
        </Grid>
    </Grid>
</Window>
