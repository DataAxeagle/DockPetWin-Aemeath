<Window x:Class="DockPetWin.CodexPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="问 Codex"
        Width="420"
        Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="输入要发给 Codex 的内容"
                   Foreground="#333333"
                   Margin="0,0,0,8" />

        <TextBox x:Name="PromptBox"
                 Grid.Row="1"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="取消"
                    MinWidth="76"
                    Margin="0,0,8,0"
                    Click="Cancel_Click" />
            <Button Content="发送"
                    MinWidth="76"
                    IsDefault="True"
                    Click="Send_Click" />
        </StackPanel>
    </Grid>
</Window>
