<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DockPetWin.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="爱弥斯设置"
        Width="960"
        Height="760"
        MinWidth="820"
        MinHeight="620"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFF7FB"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#302A36" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7B6879" />
        <SolidColorBrush x:Key="LineBrush" Color="#F0DCE7" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="SoftPanelBrush" Color="#FFFFF0F7" />
        <SolidColorBrush x:Key="AccentBrush" Color="#F06B9C" />
        <SolidColorBrush x:Key="AccentAltBrush" Color="#66BFD0" />

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#5B314B" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="SettingLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,14,14" />
        </Style>

        <Style x:Key="HelpText" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="SectionBorder" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#E6C7D7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style TargetType="{x:Type PasswordBox}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#E6C7D7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="#E6C7D7" />
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="#FFFFF2F8" />
            <Setter Property="BorderBrush" Value="#E8B9CF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFFFE6F2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFFFD7E9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#FFFFF7FB" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="20">
        <Border DockPanel.Dock="Bottom"
                Background="#FFF9FBFD"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Width="88" Margin="0,0,10,0" Click="Cancel_Click" />
                <Button Content="保存" Width="96" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            </StackPanel>
        </Border>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="爱弥斯设置" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="整理角色、AI、提醒任务和运行状态。" Style="{StaticResource HelpText}" />
            </StackPanel>
            <Button Grid.Column="1" Content="打开配置目录" Width="132" Click="OpenAgentsFolder_Click" />
        </Grid>

        <TabControl x:Name="SettingsTabs">
            <TabItem Header="基础">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,8,0">
                    <StackPanel>
                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <TextBlock Text="角色与素材" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="名称" Style="{StaticResource SettingLabel}" />
                                    <TextBox x:Name="CatNameBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,14" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="英文标识" Style="{StaticResource SettingLabel}" />
                                    <TextBox x:Name="CatIdentifierBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,14" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="对你的称呼" Style="{StaticResource SettingLabel}" />
                                    <TextBox x:Name="UserSalutationBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,14" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="资源包" Style="{StaticResource SettingLabel}" />
                                    <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="AssetPackBox"
                                                  IsEditable="True"
                                                  SelectionChanged="AssetPackBox_Changed"
                                                  LostKeyboardFocus="AssetPackBox_Changed" />
                                        <Button Grid.Column="1" Content="刷新" Width="76" Margin="8,0,0,0" Click="RefreshAssetPacks_Click" />
                                        <Button Grid.Column="2" Content="打开" Width="76" Margin="8,0,0,0" Click="OpenAssetFolder_Click" />
                                    </Grid>
                                </Grid>
                                <TextBlock x:Name="AssetPackStatusText" Style="{StaticResource HelpText}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <TextBlock Text="显示与动作" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="显示器" Style="{StaticResource SettingLabel}" />
                                    <ComboBox x:Name="DisplayBox"
                                              Grid.Row="0"
                                              Grid.Column="1"
                                              DisplayMemberPath="Title"
                                              SelectedValuePath="Id"
                                              Margin="0,0,0,14" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="显示缩放" Style="{StaticResource SettingLabel}" />
                                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="CatScaleBox" />
                                        <TextBlock Grid.Column="1" Text="%" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource MutedBrush}" />
                                    </Grid>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="起始位置" Style="{StaticResource SettingLabel}" />
                                    <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="StartPositionBox" />
                                        <TextBlock Grid.Column="1" Text="%" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource MutedBrush}" />
                                    </Grid>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="休息时长" Style="{StaticResource SettingLabel}" />
                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,14">
                                        <TextBox x:Name="RestMinBox" Width="82" />
                                        <TextBlock Text="到" VerticalAlignment="Center" Margin="8,0" Foreground="{StaticResource MutedBrush}" />
                                        <TextBox x:Name="RestMaxBox" Width="82" />
                                        <TextBlock Text="分钟" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="散步时长" Style="{StaticResource SettingLabel}" />
                                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,14">
                                        <TextBox x:Name="WalkMinBox" Width="82" />
                                        <TextBlock Text="到" VerticalAlignment="Center" Margin="8,0" Foreground="{StaticResource MutedBrush}" />
                                        <TextBox x:Name="WalkMaxBox" Width="82" />
                                        <TextBlock Text="分钟" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>

                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <TextBlock Text="陪伴状态" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="使用统计" Style="{StaticResource SettingLabel}" />
                                    <TextBlock x:Name="StatisticsText" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Foreground="{StaticResource InkBrush}" Margin="0,0,0,14" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="AI">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,8,0">
                    <StackPanel>
                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <TextBlock Text="模型配置" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Base URL" Style="{StaticResource SettingLabel}" />
                                    <TextBox x:Name="AiBaseUrlBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,14" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="模型" Style="{StaticResource SettingLabel}" />
                                    <TextBox x:Name="AiModelBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,14" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="API Key" Style="{StaticResource SettingLabel}" />
                                    <PasswordBox x:Name="AiApiKeyBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,14" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Key 环境变量" Style="{StaticResource SettingLabel}" />
                                    <TextBox x:Name="AiApiKeyEnvBox" Grid.Row="3" Grid.Column="1" />
                                </Grid>
                                <TextBlock Text="可以直接填写 key，也可以只填写环境变量名；保存后由本地应用读取。" Style="{StaticResource HelpText}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <TextBlock Text="搜索工具" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="搜索引擎" Style="{StaticResource SettingLabel}" />
                                    <ComboBox x:Name="SearchProviderBox"
                                              Grid.Row="0"
                                              Grid.Column="1"
                                              ItemsSource="{Binding SearchProviderOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              Margin="0,0,0,14" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Tavily Key" Style="{StaticResource SettingLabel}" />
                                    <Grid Grid.Row="1" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="160" />
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="TavilyApiKeyBox" ToolTip="也可以不填，改用右侧环境变量" />
                                        <TextBox x:Name="TavilyApiKeyEnvBox"
                                                 Grid.Column="1"
                                                 Margin="8,0,0,0"
                                                 ToolTip="环境变量名，默认 TAVILY_API_KEY" />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="提醒任务">
                <DockPanel Margin="0,14,8,0">
                    <Border DockPanel.Dock="Top" Style="{StaticResource SectionBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="定时提醒与任务" Style="{StaticResource SectionTitle}" />
                                <CheckBox x:Name="RemindersEnabledBox" Content="启用提醒任务" />
                                <TextBlock Text="动作可选择只提醒或执行任务；调度可选择间隔、每日、每周、每月。每周支持多选星期，每月可选择日期；执行任务时会让爱弥斯按要求整理结果并按配置保存。" Style="{StaticResource HelpText}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="新增" Width="86" Margin="12,0,8,0" VerticalAlignment="Top" Click="AddReminder_Click" />
                            <Button Grid.Column="2" Content="删除选中" Width="96" VerticalAlignment="Top" Click="DeleteReminder_Click" />
                        </Grid>
                    </Border>

                    <DataGrid x:Name="ReminderGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="54" />
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="120" />
                            <DataGridTextColumn Header="名称" Binding="{Binding Title}" Width="120" />
                            <DataGridTextColumn Header="类型" Binding="{Binding Category}" Width="80" />
                            <DataGridTemplateColumn Header="动作" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding ActionTypeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding ActionType, UpdateSourceTrigger=PropertyChanged}"
                                                  MinWidth="90" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="调度" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding ScheduleTypeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding ScheduleType, UpdateSourceTrigger=PropertyChanged}"
                                                  MinWidth="90" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="间隔(分钟)" Binding="{Binding IntervalMinutes}" Width="90" />
                            <DataGridTemplateColumn Header="小时" Width="72">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding HourOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding TimeHour, UpdateSourceTrigger=PropertyChanged}"
                                                  MinWidth="54" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="分钟" Width="72">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding MinuteOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding TimeMinute, UpdateSourceTrigger=PropertyChanged}"
                                                  MinWidth="54" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="每周" Width="270">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsWeekly}">
                                            <CheckBox Content="一" IsChecked="{Binding Monday, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,0" />
                                            <CheckBox Content="二" IsChecked="{Binding Tuesday, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,0" />
                                            <CheckBox Content="三" IsChecked="{Binding Wednesday, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,0" />
                                            <CheckBox Content="四" IsChecked="{Binding Thursday, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,0" />
                                            <CheckBox Content="五" IsChecked="{Binding Friday, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,0" />
                                            <CheckBox Content="六" IsChecked="{Binding Saturday, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,0" />
                                            <CheckBox Content="日" IsChecked="{Binding Sunday, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="每月日期" Width="94">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding MonthDayOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding DayOfMonth, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding IsMonthly}"
                                                  MinWidth="62" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="固定文案" Binding="{Binding FixedMessage}" Width="190" />
                            <DataGridCheckBoxColumn Header="AI文案" Binding="{Binding UseAiMessage}" Width="66" />
                            <DataGridTextColumn Header="AI提示词" Binding="{Binding AiPrompt}" Width="230" />
                            <DataGridTextColumn Header="任务要求" Binding="{Binding TaskPrompt}" Width="260" />
                            <DataGridCheckBoxColumn Header="保存" Binding="{Binding SaveOutput}" Width="54" />
                            <DataGridTextColumn Header="输出目录" Binding="{Binding OutputDirectory}" Width="230" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
