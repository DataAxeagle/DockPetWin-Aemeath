<Window x:Class="DockPetWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DockPetWin"
        Width="150"
        Height="150"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="Manual">
    <Grid x:Name="RootLayout" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="BubbleBorder"
                Grid.Row="0"
                MaxWidth="280"
                Margin="0,0,0,8"
                Padding="12"
                Background="#FFFFF7FB"
                BorderBrush="#E8B9CF"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
            <StackPanel>
                <ScrollViewer x:Name="BubbleTextScrollViewer"
                              MaxHeight="220"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="BubbleText"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="#302A36"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="13" />
                </ScrollViewer>
                <Image x:Name="BubbleImage"
                       Width="96"
                       Height="96"
                       Stretch="Uniform"
                       Margin="0,8,0,0"
                       Visibility="Collapsed" />
                <StackPanel x:Name="BubbleInputPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0"
                            Visibility="Collapsed">
                    <TextBox x:Name="BubbleInputBox" Width="72" TextAlignment="Right" />
                    <TextBlock Text="分钟" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#7B6879" />
                </StackPanel>
                <StackPanel x:Name="BubbleButtons"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Image x:Name="CatImage"
               Grid.Row="1"
               Width="150"
               Height="150"
               Stretch="Uniform"
               RenderTransformOrigin="0.5,0.5"
               MouseLeftButtonDown="CatImage_MouseLeftButtonDown"
               MouseRightButtonUp="CatImage_MouseRightButtonUp">
            <Image.RenderTransform>
                <ScaleTransform x:Name="MirrorTransform" ScaleX="1" ScaleY="1" />
            </Image.RenderTransform>
        </Image>
    </Grid>
</Window>
