<Window x:Class="DockPetWin.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="爱弥斯的小屋"
        Width="620"
        Height="430"
        MinWidth="420"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="#FFF6CFE2"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#2C2035" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7B4D70" />
        <SolidColorBrush x:Key="LineBrush" Color="#A7477C" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFF4FA" />
        <SolidColorBrush x:Key="AccentBrush" Color="#F06B9C" />

        <Style TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="#FFFFDDF0" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFFFC9E4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFF4A6CF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="2"
                CornerRadius="0"
                Padding="8"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TitleText"
                               Text="爱弥斯的小屋"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource InkBrush}" />
                    <TextBlock x:Name="StatusText"
                               Text="正在回家..."
                               FontSize="10"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Button x:Name="ChatButton"
                        Grid.Column="1"
                        Content="聊天"
                        Width="54"
                        Margin="8,0,6,0"
                        VerticalAlignment="Center"
                        Click="Chat_Click" />
                <Button x:Name="SettingsButton"
                        Grid.Column="2"
                        Content="设置"
                        Width="54"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Click="Settings_Click" />
                <Button x:Name="RefreshActivityButton"
                        Grid.Column="3"
                        Content="换个动作"
                        Width="76"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Click="RefreshActivity_Click" />
                <Button x:Name="ClearBubbleButton"
                        Grid.Column="4"
                        Content="清气泡"
                        Width="64"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        ToolTip="清除头顶气泡"
                        Click="ClearBubble_Click" />
                <Button x:Name="DebugModeButton"
                        Grid.Column="5"
                        Content="Debug"
                        Width="54"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Click="ToggleDebugMode_Click" />
                <Button Grid.Column="6"
                        Content="关门"
                        Width="54"
                        VerticalAlignment="Center"
                        Click="Close_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="2"
                CornerRadius="0"
                ClipToBounds="True"
                Background="White">
            <Grid x:Name="SceneHost">
                <Viewbox Stretch="Uniform">
                    <Canvas x:Name="SceneCanvas"
                            Width="1659"
                            Height="948"
                            ClipToBounds="True">
                        <Image x:Name="BackgroundImage"
                               Width="1659"
                               Height="948"
                               Stretch="Fill"
                               Panel.ZIndex="0"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Image x:Name="BedLayer"
                               Canvas.Left="65"
                               Canvas.Top="397"
                               Width="500"
                               Height="333"
                               Stretch="Uniform"
                               Panel.ZIndex="4"
                               IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Image x:Name="StudyDeskLayer"
                               Canvas.Left="635"
                               Canvas.Top="153"
                               Width="430"
                               Height="287"
                               Stretch="Uniform"
                               Panel.ZIndex="4"
                               IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Image x:Name="GamingDeskLayer"
                               Canvas.Left="1070"
                               Canvas.Top="265"
                               Width="540"
                               Height="360"
                               Stretch="Uniform"
                               Panel.ZIndex="4"
                               IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Image x:Name="ObjectAnimationImage"
                               Canvas.Left="1070"
                               Canvas.Top="265"
                               Width="540"
                               Height="360"
                               Stretch="Uniform"
                               Panel.ZIndex="5"
                               Visibility="Collapsed"
                               IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Image x:Name="SofaTableLayer"
                               Canvas.Left="650"
                               Canvas.Top="420"
                               Width="500"
                               Height="333"
                               Stretch="Uniform"
                               Panel.ZIndex="4"
                               IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Image x:Name="KitchenStoveLayer"
                               Canvas.Left="32"
                               Canvas.Top="235"
                               Width="205"
                               Height="249"
                               Stretch="Uniform"
                               Panel.ZIndex="4"
                               IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Image x:Name="SofaPlushLayer"
                               Canvas.Left="837"
                               Canvas.Top="410"
                               Width="72"
                               Height="95"
                               Stretch="Uniform"
                               Panel.ZIndex="5"
                               IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Image x:Name="TeaTableLayer"
                               Canvas.Left="338"
                               Canvas.Top="252"
                               Width="335"
                               Height="223"
                               Stretch="Uniform"
                               Panel.ZIndex="4"
                               IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Image x:Name="PetImage"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Image x:Name="EffectAnimationImage"
                               Canvas.Left="430"
                               Canvas.Top="323"
                               Width="96"
                               Height="96"
                               Stretch="Uniform"
                               Panel.ZIndex="12"
                               Visibility="Collapsed"
                               IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Image x:Name="ForegroundImage"
                               Width="1659"
                               Height="948"
                               Stretch="Fill"
                               IsHitTestVisible="False"
                               Visibility="Collapsed"
                               Panel.ZIndex="14"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Border x:Name="DebugSelectionBorder"
                                BorderBrush="#FF2F80ED"
                                BorderThickness="3"
                                Background="#112F80ED"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"
                                Panel.ZIndex="25" />
                        <Thumb x:Name="DebugResizeThumb"
                               Width="24"
                               Height="24"
                               Visibility="Collapsed"
                               Panel.ZIndex="26"
                               DragDelta="DebugResizeThumb_DragDelta"
                               DragCompleted="DebugThumb_DragCompleted">
                            <Thumb.Template>
                                <ControlTemplate TargetType="{x:Type Thumb}">
                                    <Border Background="#FF2F80ED"
                                            BorderBrush="White"
                                            BorderThickness="2" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                        <Thumb x:Name="DebugRotateThumb"
                               Width="24"
                               Height="24"
                               Visibility="Collapsed"
                               Panel.ZIndex="26"
                               DragDelta="DebugRotateThumb_DragDelta"
                               DragCompleted="DebugThumb_DragCompleted">
                            <Thumb.Template>
                                <ControlTemplate TargetType="{x:Type Thumb}">
                                    <Ellipse Fill="#FFFFC857"
                                             Stroke="White"
                                             StrokeThickness="2" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                        <Border x:Name="DebugPanel"
                                Canvas.Left="34"
                                Canvas.Top="760"
                                Panel.ZIndex="30"
                                Width="980"
                                Visibility="Collapsed"
                                Background="#F8FFFFFF"
                                BorderBrush="#FF2F80ED"
                                BorderThickness="3"
                                Padding="10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="人物动作"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"
                                           FontWeight="Bold" />
                                <ComboBox x:Name="DebugPlacementCombo"
                                          Width="170"
                                          Margin="0,0,8,0"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Key"
                                          SelectionChanged="DebugPlacementCombo_SelectionChanged" />
                                <TextBlock Text="家具物品"
                                           VerticalAlignment="Center"
                                           Margin="8,0,8,0"
                                           FontWeight="Bold" />
                                <ComboBox x:Name="DebugFurnitureCombo"
                                          Width="190"
                                          Margin="0,0,8,0"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Key"
                                          SelectionChanged="DebugFurnitureCombo_SelectionChanged" />
                                <Button Content="保存"
                                        Width="58"
                                        Margin="0,0,8,0"
                                        Click="SaveDebugLayout_Click" />
                                <Button x:Name="DebugCookButton"
                                        Content="做饭预览"
                                        Width="82"
                                        Margin="0,0,8,0"
                                        Click="DebugCook_Click" />
                                <TextBlock x:Name="DebugInfoText"
                                           VerticalAlignment="Center"
                                           Text="拖拽目标移动，蓝色方块缩放，黄色圆点旋转。"
                                           FontSize="13"
                                           Width="430"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="HomeSpeechBubble"
                                Canvas.Left="760"
                                Canvas.Top="170"
                                Panel.ZIndex="18"
                                Width="420"
                                Visibility="Collapsed"
                                Background="#EFFFF4FA"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="3"
                                CornerRadius="0"
                                Padding="14">
                            <TextBlock x:Name="HomeSpeechText"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxHeight="130"
                                       FontSize="22"
                                       LineHeight="30"
                                       Foreground="{StaticResource InkBrush}" />
                        </Border>
                        <Border x:Name="HomeLogPanel"
                                Canvas.Left="1200"
                                Canvas.Top="34"
                                Panel.ZIndex="20"
                                Width="420"
                                Background="#EFFFF4FA"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="3"
                                CornerRadius="0"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="最近行事历"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="16" />
                                <TextBlock x:Name="HomeLogText"
                                           Text="正在读取最近的小屋记录。"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource InkBrush}"
                                           FontSize="18"
                                           LineHeight="26"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="ActivityPanel"
                                Canvas.Left="34"
                                Canvas.Top="34"
                                Panel.ZIndex="20"
                                MaxWidth="360"
                                Background="#EFFFF4FA"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="3"
                                CornerRadius="0"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="现在她在做什么"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="16" />
                                <TextBlock x:Name="ActivityText"
                                           Text="正在挑一个舒服的位置。"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource InkBrush}"
                                           FontSize="22"
                                           LineHeight="30"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Canvas>
                </Viewbox>
            </Grid>
        </Border>
    </Grid>
</Window>
